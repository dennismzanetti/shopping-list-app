rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Per-user private data ────────────────────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Global shared categories (all authenticated users) ───────────────────
    match /categories/{catId} {
      allow read, write: if request.auth != null;
    }

    // ── Global shared stores (all authenticated users) ───────────────────────
    match /stores/{storeId} {
      allow read, write: if request.auth != null;
    }

    // ── Public templates (mirror of user templates with visibility='public') ──
    match /publicTemplates/{tplId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerId == request.auth.uid;
    }

    // ── Public lists (mirror of user lists with visibility='public') ─────────
    match /publicLists/{listId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerId == request.auth.uid;
    }

  }
}
