rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Lists (top-level shared collection) ─────────────────────────────────
    // Owner can read/write their own lists (public or private)
    match /lists/{listId} {
      allow read, write: if request.auth != null
                         && resource.data.ownerId == request.auth.uid;
      // Any authenticated user can read public lists
      allow read: if request.auth != null
                  && resource.data.visibility == 'public';
      // Create: caller must set ownerId to themselves
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Items subcollection — only the list owner can access items
      match /items/{itemId} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid;
      }
    }

    // ── Templates (top-level shared collection) ──────────────────────────────
    match /templates/{tplId} {
      allow read, write: if request.auth != null
                         && resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.visibility == 'public';
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
    }

    // ── Global shared categories (all authenticated users) ───────────────────
    match /categories/{catId} {
      allow read, write: if request.auth != null;
    }

    // ── Global shared stores (all authenticated users) ───────────────────────
    match /stores/{storeId} {
      allow read, write: if request.auth != null;
    }

  }
}
